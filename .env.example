# ==== slide2reveal — mẫu biến môi trường. Copy sang .env và điền giá trị thật ====

# --- Beeknoee: proxy OpenAI-compatible cho Gemini (LLM + Vision OCR) ---
BEEKNOEE_API_KEY=sk-bee-xxxxxxxxxxxxxxxx
BEEKNOEE_BASE_URL=https://platform.beeknoee.com/api/v1

# --- Model cho từng bước ---
OCR_VISION_MODEL=google/gemini-2.5-flash
TRANSFORM_MODEL=google/gemini-2.5-flash

# --- Render ---
RENDER_DPI=200

# --- Song song hoá OCR (số trang đọc đồng thời) ---
LLM_CONCURRENCY=5

# --- Timeout (giây) ---
LLM_TIMEOUT_SEC=120

# --- Reveal.js ---
REVEALJS_THEME=night
REVEALJS_TRANSITION=slide
REVEALJS_TRANSITION_SPEED=default

# --- TTS (giọng đọc đồng bộ theo từng dòng fragment) ---
# NCC TTS hoạt động: "google" | "beeknoee". Beeknoee là hành trình không cần key mới (dùng
# chung BEEKNOEE_API_KEY + OpenAI-compat /audio/speech). Catalog giọng ở app/core/tts_config.py.
TTS_DEFAULT_PROVIDER=beeknoee
TTS_DEFAULT_VOICE=zephyr
# Model Beeknoee cho giọng không khai model riêng (OpenAI-compat /audio/speech -> google TTS).
BEEKNOEE_TTS_MODEL=google/gemini-2.5-flash-tts
# Ngưỡng cắt câu (bytes) trước khi TTS text quá dài.
TTS_MAX_INPUT_BYTES=4500
# Số call TTS song song trong 1 job.
TTS_CONCURRENCY=4
# Retry lỗi NHẤT THỜI khi provider/Beeknoee bị nghẽn, 502, Connection error — có backoff (giúp audio đầy đủ).
TTS_RETRY_ATTEMPTS=4
TTS_RETRY_BASE_DELAY=0.6
# Timeout mỗi call TTS (giây) — ngắn hơn LLM; tránh treo lâu khi provider câm.
TTS_TIMEOUT_SEC=60
# Nhất quán tông giọng như người thật: tốc độ đọc (TTS_SPEED), cao độ (TTS_PITCH — google),
# ngôn ngữ ép buộc (TTS_LANGUAGE). Cùng giá trị cho mọi fragment → nghe như CÙNG một người đọc.
TTS_SPEED=1.0
TTS_PITCH=0.0
TTS_LANGUAGE=vi-VN
# Định giá: đ/ký tự (vốn vendor) + markup thu user.
TTS_VND_PER_CHAR=0.825
TTS_VENDOR_MARKUP=1.2

# Google Cloud TTS native (vi-VN-Chirp3-HD) — chỉ cần nếu TTS_DEFAULT_PROVIDER=google.
# GOOGLE_APPLICATION_CREDENTIALS là NỘI DUNG JSON service account (một dòng).
#GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account",...}
